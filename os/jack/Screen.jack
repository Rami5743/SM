// The SM standard library. Part of the nand2tetris-SM alternative.

/** A library of functions for displaying graphics on the screen. */
class Screen {
    static Array screen;
    static Array twoToThe;
    static boolean color;

    /** Initializes the Screen. */
    function void init() {
        var int i, v;
        let screen = 16384;
        let color = true;
        let twoToThe = Array.new(16);
        let v = 1;
        let i = 0;
        while (i < 16) {
            let twoToThe[i] = v;
            let v = v + v;
            let i = i + 1;
        }
        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var int i;
        let i = 0;
        while (i < 8192) {
            let screen[i] = 0;
            let i = i + 1;
        }
        return;
    }

    /** Sets the current color: true is black, false is white. */
    function void setColor(boolean b) {
        let color = b;
        return;
    }

    /** Draws the (x,y) pixel in the current color. */
    function void drawPixel(int x, int y) {
        var int address, mask;
        if ((x < 0) | (x > 511) | (y < 0) | (y > 255)) {
            do Sys.error(7);
        }
        let address = (y * 32) + (x / 16);
        let mask = twoToThe[x & 15];
        if (color) {
            let screen[address] = screen[address] | mask;
        } else {
            let screen[address] = screen[address] & (~mask);
        }
        return;
    }

    /**
     * Draws a run of pixels on one row. The address is carried along rather
     * than recomputed, which is what keeps the one multiplication and the
     * one division out of the loop: drawPixel on its own costs both.
     */
    function void drawRun(int x1, int x2, int y) {
        var int address, x, mask;
        let address = (y * 32) + (x1 / 16);
        let x = x1;
        while (~(x > x2)) {
            let mask = twoToThe[x & 15];
            if (color) {
                let screen[address] = screen[address] | mask;
            } else {
                let screen[address] = screen[address] & (~mask);
            }
            if ((x & 15) = 15) {
                let address = address + 1;
            }
            let x = x + 1;
        }
        return;
    }

    /** Draws a horizontal line, a whole word at a time where it can. */
    function void drawHorizontal(int x1, int x2, int y) {
        var int left, right, base, w;
        if (x1 > x2) {
            return;
        }
        if ((y < 0) | (y > 255)) {
            do Sys.error(8);
        }
        if (x1 < 0) {
            let x1 = 0;
        }
        if (x2 > 511) {
            let x2 = 511;
        }
        let left = x1 / 16;
        let right = x2 / 16;
        if (left = right) {
            do Screen.drawRun(x1, x2, y);
            return;
        }
        let base = y * 32;
        do Screen.drawRun(x1, (left * 16) + 15, y);
        let w = left + 1;
        while (w < right) {
            if (color) {
                let screen[base + w] = -1;
            } else {
                let screen[base + w] = 0;
            }
            let w = w + 1;
        }
        do Screen.drawRun(right * 16, x2, y);
        return;
    }

    /** Draws a vertical line, stepping the address a row at a time. */
    function void drawVertical(int x, int y1, int y2) {
        var int address, y, mask;
        if ((x < 0) | (x > 511)) {
            do Sys.error(8);
        }
        let address = (y1 * 32) + (x / 16);
        let mask = twoToThe[x & 15];
        let y = y1;
        while (~(y > y2)) {
            if (color) {
                let screen[address] = screen[address] | mask;
            } else {
                let screen[address] = screen[address] & (~mask);
            }
            let address = address + 32;
            let y = y + 1;
        }
        return;
    }

    /** Draws a line from (x1,y1) to (x2,y2). */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int dx, dy, a, b, difference, swap;
        if (y1 = y2) {
            do Screen.drawHorizontal(Math.min(x1, x2), Math.max(x1, x2), y1);
            return;
        }
        if (x1 = x2) {
            do Screen.drawVertical(x1, Math.min(y1, y2), Math.max(y1, y2));
            return;
        }
        if (x1 > x2) {
            let swap = x1;
            let x1 = x2;
            let x2 = swap;
            let swap = y1;
            let y1 = y2;
            let y2 = swap;
        }
        let dx = x2 - x1;
        let dy = y2 - y1;
        let a = 0;
        let b = 0;
        let difference = 0;
        if (dy > 0) {
            while ((~(a > dx)) & (~(b > dy))) {
                do Screen.drawPixel(x1 + a, y1 + b);
                if (difference < 0) {
                    let a = a + 1;
                    let difference = difference + dy;
                } else {
                    let b = b + 1;
                    let difference = difference - dx;
                }
            }
            return;
        }
        while ((~(a > dx)) & (~(b < dy))) {
            do Screen.drawPixel(x1 + a, y1 + b);
            if (difference < 0) {
                let a = a + 1;
                let difference = difference - dy;
            } else {
                let b = b - 1;
                let difference = difference - dx;
            }
        }
        return;
    }

    /** Draws a filled rectangle with the given corners. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        var int y;
        if ((x1 > x2) | (y1 > y2)) {
            do Sys.error(9);
        }
        let y = y1;
        while (~(y > y2)) {
            do Screen.drawHorizontal(x1, x2, y);
            let y = y + 1;
        }
        return;
    }

    /** Draws a filled circle of radius r around (x,y). */
    function void drawCircle(int x, int y, int r) {
        var int dy, half;
        if (r < 0) {
            do Sys.error(13);
        }
        if (r > 181) {
            do Sys.error(13);
        }
        let dy = -r;
        while (~(dy > r)) {
            let half = Math.sqrt((r * r) - (dy * dy));
            do Screen.drawHorizontal(x - half, x + half, y + dy);
            let dy = dy + 1;
        }
        return;
    }
}
