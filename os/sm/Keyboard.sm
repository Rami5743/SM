push @c
call String.appendChar
pop @line
label endif.3
call Keyboard.readChar
pop @c
goto while.2
label endwhile.2
call Output.println
pop Sys.discard
push @line
return
function Keyboard.readInt(message) locals line, value
push @message
call Keyboard.readLine
pop @line
push @line
call String.intValue
pop @value
push @line
call String.dispose
pop Sys.discard
push @value
return
