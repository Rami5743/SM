function Keyboard.init()
push 0
return
function Keyboard.keyPressed()
push 24576
call Memory.peek
return
function Keyboard.readChar() locals c
push 0
call Output.printChar
pop Sys.discard
label while.0
call Keyboard.keyPressed
push 0
eq
not
if-goto endwhile.0
goto while.0
label endwhile.0
call Keyboard.keyPressed
pop @c
label while.1
call Keyboard.keyPressed
push 0
eq
not
not
if-goto endwhile.1
goto while.1
label endwhile.1
call Output.backSpace
pop Sys.discard
push @c
call Output.printChar
pop Sys.discard
push @c
return
function Keyboard.readLine(message) locals line, c
push @message
call Output.printString
pop Sys.discard
push 80
call String.new
pop @line
call Keyboard.readChar
pop @c
label while.2
push @c
push 128
eq
not
not
if-goto endwhile.2
push @c
push 129
eq
not
if-goto else.3
push @line
call String.length
push 0
gt
not
if-goto else.4
