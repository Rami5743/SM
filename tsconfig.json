{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@sm/core": ["packages/sm-core/src/index.ts"],
      "@sm/emulator": ["packages/sm-emulator/src/index.ts"],
      "@sm/tst": ["packages/sm-tst/src/index.ts"],
      "@sm/to-asm": ["packages/sm-to-asm/src/index.ts"],
      "@sm/jack": ["packages/jack-to-sm/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tools/**/*.ts", "web/src/**/*.ts"]
}
