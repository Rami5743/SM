!fib(n)fib1,i
	<- 2048
	-> @fib1
	//fib1[0]=0
		<- @fib1
		<- 0
		-> []
	//fib1[1]=1
		//<- @fib1+1
			<- @fib1
			<- 1
			+
		<- 1
		-> []
	//i=1
		<- 1
		-> @i
	while:
		//~(i<n)
			<- @i
			<- @n
			<
			~
		?-->return		
		
		//fib1[i+1]=fib1[i-1]+fib1[i]
			//<-@fib1+i+1
				<-@fib1
				<-@i
				<-1
				+
				+
			//<-fib1[i-1]
				<-@fib1
				<-@i
				<-1
				-
				+
				[]
			//<-fib1[i]
				<-@fib1
				<-@i
				+
				[]
			+
			->[]
		//i=i+1
			<- @i
			<- 1
			+
			-> @i
		-->while
	return:
		//return fib1 
			<-@fib1
			<--
			