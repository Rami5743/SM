// A label, an unconditional jump and a conditional one.
// Computes 1 + 2 + ... + n and returns it.
function BasicLoop.sum(n) locals total, i
	push 0
	pop @total
	push 1
	pop @i
	label loop
		// stop once i > n
		push @n
		push @i
		lt
		if-goto done
		push @total
		push @i
		add
		pop @total
		push @i
		push 1
		add
		pop @i
		goto loop
	label done
	push @total
	return
