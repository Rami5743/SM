// A label, an unconditional jump and a conditional one.
// Computes 1 + 2 + ... + n and returns it.
!BasicLoop.sum(n) total, i
	<-0
	->@total
	<-1
	->@i
	loop:
		// stop once i > n
		<-@n
		<-@i
		<
		?-->done
		<-@total
		<-@i
		+
		->@total
		<-@i
		<-1
		+
		->@i
		-->loop
	done:
	<-@total
	<--
