// A frame has to survive a call. Each of these fills its own internal
// variables, calls the next, and then checks that its own are untouched.
function NestedCall.outer(n) locals a, b
	push 11
	pop @a
	push 22
	pop @b
	push @n
	call NestedCall.middle
	// the returned value, plus our own two, which must still be 11 and 22
	push @a
	add
	push @b
	add
	return

function NestedCall.middle(n) locals a, b
	push 33
	pop @a
	push 44
	pop @b
	push @n
	call NestedCall.inner
	push @a
	add
	push @b
	add
	return

function NestedCall.inner(n)
	push @n
	push @n
	add
	return
