// The same control flow, over an array in the heap. Writes the first n
// Fibonacci numbers from the given address and returns that address.
function FibonacciSeries.fill(at, n) locals i
	// first[0] = 0
	push @at
	push 0
	pop-indirect
	// first[1] = 1
	push @at
	push 1
	add
	push 1
	pop-indirect
	push 1
	pop @i
	label loop
		// stop once i+1 > n-1, that is once i > n-2
		push @n
		push 2
		sub
		push @i
		lt
		if-goto done
		// at[i+1] = at[i-1] + at[i]
		push @at
		push @i
		add
		push 1
		add
		push @at
		push @i
		add
		push 1
		sub
		push-indirect
		push @at
		push @i
		add
		push-indirect
		add
		pop-indirect
		push @i
		push 1
		add
		pop @i
		goto loop
	label done
	push @at
	return
