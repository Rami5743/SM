// Every arithmetic and logical command, and the convention that only the
// most significant bit of a register carries a truth value.

// arithmetic
push 17
push 17
eq  // true
push 17
push 16
eq  // false
push 16
push 17
lt  // true
push 17
push 16
lt  // false
push 16
push 17
gt  // false
push 17
push 16
gt  // true
push 57
push 31
add  // 88
push 53
push 112
sub  // -59

// the operators that take one operand
push 82
neg  // -82
push 0
not  // -1, every bit set

// bitwise, on values whose significant bit is set and clear
push 82
push 27
and  // 18
push 82
push 27
or  // 91
