// A dotted name is an ordinary global. The dot means nothing to the machine;
// it is the convention a Jack compiler uses for a class's statics, and no
// rule of this language.
push 111
pop Class1.a
push 333
pop Class2.b
push 888
pop plain

push Class1.a
push Class2.b
sub  // -222
push plain
add  // 666

// A dotted name and an undotted one are simply two different names.
push Class1.a
push plain
add  // 999
